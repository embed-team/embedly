{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "embedly-music",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "music.embeds.media", "custom_domain": true }],
  "secrets": {
    "required": [
      "SPOTIFY_CLIENT_ID",
      "SPOTIFY_CLIENT_SECRET",
      "TIDAL_CLIENT_ID",
      "TIDAL_CLIENT_SECRET",
    ],
  },
  "kv_namespaces": [{ "binding": "CACHE" }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
