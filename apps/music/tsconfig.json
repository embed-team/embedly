{
  "extends": "@embedly/config/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "emitDeclarationOnly": true,
    "declarationDir": "./types",
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": ["src/**/*", "*.ts"],
